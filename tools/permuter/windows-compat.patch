+def _win_argv(compile_cmd: str, c_name: str, o_name: str):
+    """Windows-compat (sm64ds-decomp): return (argv, env) for one candidate compile.
+
+    compile.sh is a bash script, and git-bash startup costs ~400ms per candidate.
+    When import_func.setup_dir has written a `cc.txt` sidecar next to it we call
+    mwccarm.exe DIRECTLY instead (~140ms, roughly 3x the throughput). Falls back to
+    routing the script through bash when there is no sidecar."""
+    env = None
+    cc = os.path.join(os.path.dirname(compile_cmd), "cc.txt")
+    if os.path.isfile(cc):
+        with open(cc, encoding="utf-8") as f:
+            spec = json.load(f)
+        env = dict(os.environ)
+        if spec.get("license"):
+            env["LM_LICENSE_FILE"] = spec["license"]
+        return [*spec["cmd"], "-o", o_name, c_name], env
+    return ["bash", compile_cmd, c_name, "-o", o_name], env
+
+
