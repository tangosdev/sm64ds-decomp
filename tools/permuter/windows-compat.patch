 from typing import List
+import io
+import os
 import subprocess
 
 
 def preprocess(filename: str, cpp_args: List[str] = []) -> str:
+    # Windows-compat (sm64ds-decomp): there is no `cpp` binary on Windows, so run the
+    # pure-python pcpp preprocessor in-process. Same contract: -P (no linemarkers),
+    # -nostdinc, -DPERMUTER.
+    if os.name == "nt":
+        from pcpp.preprocessor import Preprocessor, OutputDirective, Action
+
+        class _P(Preprocessor):
+            def on_include_not_found(self, *args):
+                # A base.c handed to the permuter is already self-contained; any
+                # leftover #include is dropped rather than fatal.
+                raise OutputDirective(Action.IgnoreAndPassThrough)
+
+        pp = _P()
+        pp.line_directive = None          # equivalent of -P
+        pp.define("PERMUTER 1")
+        for a in cpp_args:
+            if a.startswith("-D"):
+                pp.define(a[2:].replace("=", " ", 1))
+            elif a.startswith("-I"):
+                pp.add_path(a[2:])
+        with open(filename, encoding="utf-8") as f:
+            pp.parse(f.read(), filename)
+        out = io.StringIO()
+        pp.write(out)
+        return out.getvalue()
+
     return subprocess.check_output(
         ["cpp"] + cpp_args + ["-P", "-nostdinc", "-DPERMUTER", filename],
         universal_newlines=True,
