#!/bin/sh
# Pre-push gate for direct-to-main pushes.
#
# The `validate` CI check only runs on pull_request_target, so anything pushed straight to
# main never gets byte-match checked. This runs the same link verification locally (this box
# has the ROM + toolchain) and refuses the push if a src/ file does not reproduce the ROM.
#
# The checks below the main gate (duplicate sources, draft compiles, the unresolved-reference
# ratchet) run on EVERY push rather than only main-targeted ones: none needs the ROM, and
# each catches mistakes that are invisible in review because every byte still matches.
#
# Install:
#   cp tools/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Bypass once (you had better be sure):
#   git push --no-verify

remote_ref_check() {
  # stdin: <local ref> <local sha> <remote ref> <remote sha>
  while read -r _local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
      refs/heads/main) ;;
      *) continue ;;   # only gate main
    esac

    # Deleting a branch, or nothing to push
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      range="$local_sha"          # new branch: check everything it introduces
    else
      range="$remote_sha..$local_sha"
    fi

    echo "pre-push: link-verifying src/ changes in $range"
    if ! python tools/prepush_linkcheck.py --range "$range"; then
      echo "pre-push: REFUSING to push (see above). Override with --no-verify if you are certain." >&2
      return 1
    fi
  done
  return 0
}

# --- checks that run on EVERY push, not only main ---------------------------
#
# The gate above only fires for refs/heads/main, because link verification needs
# the ROM and toolchain and costs minutes. These need neither, and the mistakes
# they catch land on feature branches.

# Two source files for one symbol. delinks.txt names one path per address range,
# and every gate in this tree is driven from delinks.txt -- so the other half is
# compiled by nothing and checked by nothing. Pure filesystem scan, milliseconds.
if ! python tools/check_duplicate_sources.py; then
  echo "pre-push: REFUSING to push (see above). Override with --no-verify if you are certain." >&2
  exit 1
fi

# Does every NONMATCHING draft in src/ still COMPILE? enroll.py leaves a bannered
# draft out of the ROM build, so nothing else compiles it: #3085's draft stopped
# compiling when a header retyped a callee and stayed broken for nine days. Same
# compiler-present test and NOT CHECKED message as the src_tu gate above.
if [ -f tools/mwccarm/2004/b56/mwccarm.exe ]; then
  if ! python tools/check_drafts_compile.py --quiet; then
    echo "pre-push: REFUSING to push (see above). Override with --no-verify if you are certain." >&2
    exit 1
  fi
else
  echo "pre-push: NONMATCHING DRAFT COMPILE GATE NOT CHECKED -- no tools/mwccarm/2004/b56/mwccarm.exe"
  echo "          in this worktree. This is not a pass. Wire the worktree up and re-run"
  echo "          'python tools/check_drafts_compile.py' before trusting this push."
fi

# Reference resolvability needs tools/eligible.py, which compiles ~11,100 files and
# takes minutes -- far too slow for a hook. So this checks only when a report for
# THIS commit already exists, and otherwise says nothing was checked rather than
# implying it passed.
if python tools/check_references.py >/dev/null 2>&1; then
  echo "pre-push: unresolved references OK"
elif python tools/check_references.py 2>&1 | grep -q "report describes\|no commit stamp\|missing "; then
  echo "pre-push: (skipping reference check -- no current eligibility report;"
  echo "          run 'python tools/eligible.py' to include it)"
else
  echo "pre-push: reference check FAILED"
  python tools/check_references.py
  echo "pre-push: REFUSING to push (see above). Override with --no-verify if you are certain." >&2
  exit 1
fi

remote_ref_check || exit 1
exit 0
